# Ignore generated mutant directories by default; selected Java/C pairs are tracked explicitly.
/FormalBench-data/FilteredData/fault_mutants/run_ukcw__uc/*/mutants/*/
# Local archive of mutant sources excluded from the paired completeness evaluation.
/FormalBench-data/FilteredData/fault_mutants/excluded_from_paired_completeness/
# Formal Specification Syntax Report
/FormalBench-data/FilteredData/specifications/seed_726_per_category_10_653ade686f/checks/
/FormalBench-data/FilteredData/specifications/seed_726_per_category_10_653ade686f/syntax-checks-*.json

# Keep only source-controlled verification inputs, scripts, and summaries. The leading
# slash is relative to this repository root; do not repeat the repository name.
/verification/java_arrays/*
!/verification/java_arrays/README.md
!/verification/java_arrays/clients/
!/verification/java_arrays/clients/**
!/verification/java_arrays/contracts/
!/verification/java_arrays/contracts/**
!/verification/java_arrays/scripts/
!/verification/java_arrays/scripts/**
# The scripts allowlist must not re-include Python's generated bytecode.
/verification/java_arrays/scripts/**/__pycache__/
/verification/java_arrays/scripts/**/*.pyc
!/verification/java_arrays/results/
# Keep curated top-level Markdown summaries; raw runs and diagnostic files stay local.
/verification/java_arrays/results/*
!/verification/java_arrays/results/*.md

# Only the main 30-second goal / 600-second program run is eligible for tracking.
# Smoke, repair, and fast diagnostic run directories remain entirely local.
/verification/specification_evaluation/results/*
!/verification/specification_evaluation/results/pilot10_seed726_20260925_budget600_goal30/
# Within the main run, retain its summary and original-program results only:
# Java's classified record and C's per-goal WP report.
/verification/specification_evaluation/results/pilot10_seed726_20260925_budget600_goal30/**
!/verification/specification_evaluation/results/pilot10_seed726_20260925_budget600_goal30/**/
!/verification/specification_evaluation/results/pilot10_seed726_20260925_budget600_goal30/summary.json
!/verification/specification_evaluation/results/pilot10_seed726_20260925_budget600_goal30/cases/*/original/java/record.json
!/verification/specification_evaluation/results/pilot10_seed726_20260925_budget600_goal30/cases/*/original/c/wp-report.json

# Generated compiler output (after allowlists so it cannot be re-included).
/FormalBench-data/FilteredData/compiled_classes/
__pycache__/
*.pyc
*.pyo
*.class
*.o
*.obj
*.cmx
*.cmi
*.cmo
*.cmxs
