# Ignore generated mutant directories by default; selected Java/C pairs are tracked explicitly.
/FormalBench-data/FilteredData/fault_mutants/run_ukcw__uc/*/mutants/*/
# Local archive of mutant sources excluded from the paired completeness evaluation.
/FormalBench-data/FilteredData/fault_mutants/excluded_from_paired_completeness/
# Formal Specification Syntax Report
/FormalBench-data/FilteredData/specifications/seed_726_per_category_10_653ade686f/checks/
/FormalBench-data/FilteredData/specifications/seed_726_per_category_10_653ade686f/syntax-checks-*.json

# Keep only source-controlled verification inputs, scripts, and summaries. The leading
# slash is relative to this repository root; do not repeat the repository name.
/verification/java_arrays/*
!/verification/java_arrays/README.md
!/verification/java_arrays/clients/
!/verification/java_arrays/clients/**
!/verification/java_arrays/contracts/
!/verification/java_arrays/contracts/**
!/verification/java_arrays/scripts/
!/verification/java_arrays/scripts/**
# The scripts allowlist must not re-include Python's generated bytecode.
/verification/java_arrays/scripts/**/__pycache__/
/verification/java_arrays/scripts/**/*.pyc
!/verification/java_arrays/results/
# Keep curated top-level Markdown summaries; raw runs and diagnostic files stay local.
/verification/java_arrays/results/*
!/verification/java_arrays/results/*.md

# Final experiment: 10-second goals / 300-second cases, including the integrated C sorts.
# Pilot, smoke, repair, and separate diagnostic runs remain local.
/verification/specification_evaluation/results/*
!/verification/specification_evaluation/results/originals_stop_tool_error_20260927T161243Z_goal10_case300/
# Retain the experiment metadata, frozen inputs, and original/mutant case evidence.
/verification/specification_evaluation/results/originals_stop_tool_error_20260927T161243Z_goal10_case300/**
!/verification/specification_evaluation/results/originals_stop_tool_error_20260927T161243Z_goal10_case300/**/
!/verification/specification_evaluation/results/originals_stop_tool_error_20260927T161243Z_goal10_case300/run.json
!/verification/specification_evaluation/results/originals_stop_tool_error_20260927T161243Z_goal10_case300/summary.json
!/verification/specification_evaluation/results/originals_stop_tool_error_20260927T161243Z_goal10_case300/README.md
!/verification/specification_evaluation/results/originals_stop_tool_error_20260927T161243Z_goal10_case300/statistics.json
!/verification/specification_evaluation/results/originals_stop_tool_error_20260927T161243Z_goal10_case300/sort_c_integration.json
!/verification/specification_evaluation/results/originals_stop_tool_error_20260927T161243Z_goal10_case300/frozen_specs/**
!/verification/specification_evaluation/results/originals_stop_tool_error_20260927T161243Z_goal10_case300/cases/*/*/*/record.json
!/verification/specification_evaluation/results/originals_stop_tool_error_20260927T161243Z_goal10_case300/cases/*/*/*/transfer.json
